    background-size: cover;
    color: grey;
}

#usuario5 {
    background-image: url(../images/cr7.all.webp);
    background-size: cover;
    color: yellow;
}

.video {
    display: none;
    width: 1500px;
    height: 800px;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 999;
}

#usuario1:hover > .video {
    display: block;
    background: url('https://c.tenor.com/rpBYoXPmUPYAAAAd/tenor.gif');
    background-size: cover;
    background-repeat: no-repeat;
}

