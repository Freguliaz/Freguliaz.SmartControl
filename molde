* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    height: 100vh;
    display: flex;
    flex-direction: column;
    text-align: center;
    justify-content: center;
    font-size: 150px;
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    color: red;
    background-color: black;
}

#titulo {
    margin-bottom: 24px;
}

.usuarios {
    display: flex;
    justify-content: center;
    flex-direction: row;
    gap: 24px;
}

.usuario {
    background-color: aliceblue;
    width: 100px;
    height: 100px;
    margin-bottom: 24px;
    font-size: 16px;
    padding-top: 100px;
}

#usuario1 {
    background-image: url(../images/cr7.sporting.jpg);
    background-size: cover;
    color: green;
}

#usuario2 {
    background-image: url(../images/cr7.manchester.jpg);
    background-size: cover;
}

#usuario3 {
    background-image: url(../images/cr7.real.jpg);
    background-size: cover;
    color: white;
}

#usuario4 {
